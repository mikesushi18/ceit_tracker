# Security: prevent any uploaded file from being executed as PHP.
# This folder should only ever serve as storage for submitted documents.

# Apache 2.4+
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|php\d?|phtml|pht)$">
        Require all denied
    </FilesMatch>
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|php\d?|phtml|pht)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Belt-and-suspenders: also strip PHP handling entirely for this folder
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
