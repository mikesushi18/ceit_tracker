{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{admin/**/*.php,admin/print-assets/*,chairperson/**/*.php,faculty/**/*.php,includes/**/*.php,*.php,*.docx,*.png,*.jpg,*.jpeg,admin/**/*.{png,jpg,jpeg},chairperson/**/*.{png,jpg,jpeg},faculty/**/*.{png,jpg,jpeg}}"
    }
  },
  "routes": [
    { "src": "/uploads/(.*)", "dest": "/api/index.php?storage=$1" },
    { "src": "/(.*\\.php)$", "dest": "/api/index.php?path=$1" },
    { "src": "/(.*\\.sql|README\\.md|SETUP_GUIDE\\.md|\\.env.*)$", "dest": "/api/index.php?path=not-found.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/index.php?path=$1" }
  ]
}
